{
  "manifest_version": 3,
  "name": "Omarchy Web Theme",
  "version": "0.1.0",
  "description": "Repaints websites in your current Omarchy theme, live.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "js": ["lib/color.js", "lib/mapper.js", "adapters/index.js", "lib/engine.js", "content.js"]
    }
  ],
  "action": {
    "default_title": "Omarchy Web Theme",
    "default_popup": "popup/popup.html"
  }
}
