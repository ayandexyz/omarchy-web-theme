#!/usr/bin/env python3
"""Native messaging host: stream the current Omarchy palette to the browser.

The extension opens a long-lived port (chrome.runtime.connectNative). This host
sends the palette once on connect, then again every time the Omarchy theme
changes. Omarchy bumps theme.generation on every theme switch, so watching that
one small file is enough.
"""

import json
import os
import struct
import sys
import threading
import time
import tomllib
from pathlib import Path

STATE_DIR = Path(
    os.environ.get("OMARCHY_WEB_THEME_STATE_DIR")
    or Path.home() / ".local/state/omarchy/current"
)
THEME_DIR = STATE_DIR / "theme"
POLL_SECONDS = 1.0

_write_lock = threading.Lock()


def send(message):
    data = json.dumps(message, separators=(",", ":")).encode()
    with _write_lock:
        sys.stdout.buffer.write(struct.pack("<I", len(data)))
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def read_message():
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    (length,) = struct.unpack("<I", header)
    return json.loads(sys.stdin.buffer.read(length))


def read_text(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def load_palette():
    try:
        with open(THEME_DIR / "colors.toml", "rb") as f:
            colors = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as error:
        return {"type": "error", "error": f"cannot read colors.toml: {error}"}

    mode = colors.pop("mode", "dark")
    return {
        "type": "palette",
        "name": read_text(STATE_DIR / "theme.name"),
        "generation": read_text(STATE_DIR / "theme.generation"),
        "mode": mode,
        # Only plain "#rrggbb" values are colors; skip anything else a theme adds.
        "colors": {
            key: value
            for key, value in colors.items()
            if isinstance(value, str) and value.startswith("#")
        },
    }


def theme_stamp():
    stamp = read_text(STATE_DIR / "theme.generation")
    try:
        stamp += f":{(THEME_DIR / 'colors.toml').stat().st_mtime_ns}"
    except OSError:
        pass
    return stamp


def watch():
    last = None
    while True:
        stamp = theme_stamp()
        if stamp != last:
            last = stamp
            send(load_palette())
        time.sleep(POLL_SECONDS)


def main():
    threading.Thread(target=watch, daemon=True).start()

    # The browser closes stdin when the port disconnects; exit with it.
    while True:
        message = read_message()
        if message is None:
            return
        if message.get("type") == "get":
            send(load_palette())


if __name__ == "__main__":
    main()
